{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NBO R2 run record",
  "type": "object",
  "required": ["run_id", "model", "seed", "config_sha256", "code_commit", "status", "metrics"],
  "properties": {
    "run_id": {"type": "string"},
    "model": {"type": "string"},
    "seed": {"type": "integer"},
    "config_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "code_commit": {"type": "string"},
    "status": {"enum": ["success", "failed", "pilot", "historical_negative_control", "analytical_check"]},
    "domain": {"type": "object"},
    "horizon_boundary": {"type": "object"},
    "optimizer": {"type": "object"},
    "hessian": {"type": "object"},
    "stopping": {"type": "object"},
    "held_out_distribution": {"type": "string"},
    "metrics": {
      "type": "object",
      "properties": {
        "value_error": {"type": ["number", "null"]},
        "policy_error": {"type": ["number", "null"]},
        "boundary_error": {"type": ["number", "null"]},
        "residual_mean": {"type": ["number", "null"]},
        "improvement_gap": {"type": ["number", "null"]},
        "exploitability": {"type": ["number", "null"]}
      }
    },
    "raw_output_sha256": {"type": ["string", "null"]},
    "notes": {"type": "string"}
  }
}
