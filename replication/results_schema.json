{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NBO R3 run record",
  "type": "object",
  "required": ["run_id", "model", "seed", "config_sha256", "code_commit", "status", "metrics", "raw_output_sha256"],
  "properties": {
    "run_id": {"type": "string"},
    "model": {"type": "string"},
    "seed": {"type": "integer"},
    "config_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "code_commit": {"type": "string", "minLength": 7},
    "status": {"enum": ["success", "failed", "pilot", "reference_audit", "historical_negative_control", "analytical_check"]},
    "domain": {"type": "object"},
    "horizon_boundary": {"type": "object"},
    "optimizer": {"type": "object"},
    "hessian": {"type": "object"},
    "stopping": {"type": "object"},
    "held_out_distribution": {"type": "string"},
    "metrics": {"type": "object", "additionalProperties": {"type": ["number", "null"]}},
    "raw_output_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "raw_output_path": {"type": "string"},
    "notes": {"type": "string"}
  }
}
