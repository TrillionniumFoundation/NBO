+    "revisions/2026-09-22-r9/validation_report.json": "ea96b16f2a9efb67f030795c9facefc1234833990cc37f554f2cecc9cf664f61",
+    "supp.tex": "7d72b624cdd3799f2acfb8528b6e7028095cae27db38f96ba6a93431c0462297"
+  }
+}
